# =====================================================================
# Miku Visual Companion - Variáveis de Ambiente (.env.example)
# Copie este arquivo para ".env" e adicione sua chave de API:
#   copy .env.example .env
# =====================================================================

# Chave gratuita da API do Google Gemini em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Configurações do Companion
RIN_MODEL=gemini-3.5-flash-lite
RIN_DEFAULT_MODE=casual
RIN_MIC_START_MUTED=true
RIN_PERSONA_PATH=config/persona.yaml
RIN_LOG_LEVEL=INFO

# Voz (Miku RVC Local + Fallback Edge-TTS)
RIN_TTS_PROVIDER=miku_local
RIN_MIKU_MODEL=1a_miku_default_rvc_(aple)
RIN_MIKU_PHONETIC_PTBR=false
RIN_MIKU_TIMEOUT_S=28.0
RIN_TTS_VOICE=pt-BR-FranciscaNeural
RIN_TTS_RATE=+10%
RIN_TTS_PITCH=+15Hz
